# Salin menjadi .env.local (untuk tes di komputer sendiri)
APP_NAME="ERP Lokal"
APP_ENV=local
APP_DEBUG=true
APP_KEY=                      # isi: docker compose -f docker-compose.local.yml run --rm app php artisan key:generate --show
APP_URL=http://localhost:8080
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=erp
DB_ROOT_PASSWORD=root
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
