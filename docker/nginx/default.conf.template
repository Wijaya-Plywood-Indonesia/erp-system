# Redirect HTTP -> HTTPS
server {
    listen 80;
    server_name kayu.wijayaplywoods.com wahana.wijayaplywoods.com;
    location / { return 301 https://$host$request_uri; }
}

# Proxy Wahana (Port 443)
server {
    listen 443 ssl;
    http2 on;
    server_name wahana.wijayaplywoods.com;

    ssl_certificate     /etc/letsencrypt/live/kayu.wijayaplywoods.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kayu.wijayaplywoods.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 64M;
    server_tokens off;

    location / {
        proxy_pass https://host.docker.internal:8444;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_verify off;
    }
}

# Kayu App (Port 443)
server {
    listen 443 ssl default_server;
    http2 on;
    server_name kayu.wijayaplywoods.com;

    ssl_certificate     /etc/letsencrypt/live/kayu.wijayaplywoods.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kayu.wijayaplywoods.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    root /var/www/html/public;
    index index.php;
    client_max_body_size 64M;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / { try_files $uri $uri/ /index.php?$query_string; }

    location ~ \.php$ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $php_upstream app:9000;
        fastcgi_pass $php_upstream;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 120;
    }

    location ~* \.(?:css|js|woff2?|png|jpg|jpeg|gif|svg|ico)$ {
        expires 30d;
        access_log off;
        try_files $uri /index.php?$query_string;
    }
    location ~ /\.(?!well-known) { deny all; }
}
