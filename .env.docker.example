# Salin ke /opt/erp/.env di VPS lalu isi. JANGAN di-commit.
# --- dipakai compose ---
APP_IMAGE=ghcr.io/PEMILIK/NAMA-REPO-app:latest
WEB_IMAGE=ghcr.io/PEMILIK/NAMA-REPO-web:latest
DOMAIN=kayu.wijayaplywoods.com

# --- dipakai Laravel ---
APP_NAME="Wijaya Plywoods ERP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://kayu.wijayaplywoods.com

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=GANTI_PASSWORD_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Real-time memakai Pusher (salin dari .env lama di shared hosting)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# Salin juga dari .env lama: MAIL_*, kunci API (ESP/BKBM), dan variabel kustom lain.
LOG_CHANNEL=stderr
